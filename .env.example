# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (replace USER and PASS with your Atlas database user)
# Password special chars must be URL-encoded (@ → %40, # → %23, etc.)
# mongodb+srv is fine — backend resolves SRV via public DNS if your ISP blocks it.
# Or paste Atlas "Standard connection string" (mongodb://…) instead.
MONGODB_URI=mongodb+srv://USER:PASS@himelcluster.fxzuftr.mongodb.net/toys_factory_erp?appName=HimelCluster

# false when using Atlas or local MongoDB; true = in-memory dev only (no install)
USE_MEMORY_DB=false

# CORS — frontend dev URL and Vercel URL (also used by Socket.io)
CORS_ORIGIN=http://localhost:3000,https://toys-factory-erp-one.vercel.app

# JWT signing secret (optional in dev; fallback is used if empty)
# JWT_SECRET=change-me

# Optional API key for future protected routes (leave empty in dev)
API_KEY=

# Local Redis (optional — brew install redis && brew services start redis):
REDIS_URL=redis://127.0.0.1:6379
# Leave empty to use in-memory cache fallback:
# REDIS_URL=

# Cloudinary destroy (server only — never expose these to the Next.js client).
# Needed to delete replaced/removed images. Unsigned upload still uses NEXT_PUBLIC_* on the web app.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
